# ==========================================
# Valkey / Redis Connection Configuration
# ==========================================
# Provide either a full VALKEY_URL (or REDIS_URL) or individual connection parameters:
VALKEY_URL=redis://:YOUR_PASSWORD@your-valkey-host.example.com:6379/0

# Optional individual parameters (if not using VALKEY_URL):
# VALKEY_HOST=your-valkey-host.example.com
# VALKEY_PORT=6379
# VALKEY_PASSWORD=YOUR_PASSWORD
# VALKEY_USERNAME=
# VALKEY_SSL=false

# ==========================================
# Google Cloud & Vertex AI Configuration
# ==========================================
GOOGLE_CLOUD_PROJECT=mague-tf
GOOGLE_CLOUD_LOCATION=us-central1
VERTEXAI_MODEL=gemini-1.5-flash
VERTEXAI_EMBEDDING_MODEL=text-embedding-004

# ==========================================
# Semantic Cache Settings
# ==========================================
# Distance threshold (0.0 to 1.0):
# Smaller value = stricter similarity match
# Higher value = looser similarity match (e.g. 0.20 is standard for text-embedding-004)
SEMANTIC_CACHE_DISTANCE_THRESHOLD=0.20

# Cache entry TTL in seconds (e.g., 3600 = 1 hour, 86400 = 1 day)
SEMANTIC_CACHE_TTL=3600

# Cache index name in Valkey
SEMANTIC_CACHE_INDEX_NAME=support_concierge_cache
SEMANTIC_CACHE_PREFIX=support_concierge
